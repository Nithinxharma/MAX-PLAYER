<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group>
        <!-- Soft Ambient Glow -->
        <path
            android:pathData="M 256,256 m -200,0 a 200,200 0 1,1 400,0 a 200,200 0 1,1 -400,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="256"
                    android:centerY="256"
                    android:gradientRadius="200"
                    android:type="radial">
                    <item android:color="#33FF3B30" android:offset="0.0" />
                    <item android:color="#22007AFF" android:offset="0.6" />
                    <item android:color="#00000000" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Center Fold Ribbon Layer (Back/Middle Depth) -->
        <path
            android:pathData="M 180,140 C 215,200 240,285 256,330 C 272,285 297,200 332,140 C 362,88 410,95 435,145 L 340,350 C 300,430 212,430 172,350 L 77,145 C 102,95 150,88 180,140 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="120"
                    android:startY="100"
                    android:endX="390"
                    android:endY="420"
                    android:type="linear">
                    <item android:color="#FFFF2D92" android:offset="0.0" />
                    <item android:color="#FFA855F7" android:offset="0.45" />
                    <item android:color="#FF007AFF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left Ribbon Leg (Red -> Coral -> Magenta) -->
        <path
            android:pathData="M 72,130 C 72,90 108,68 148,88 C 182,105 210,148 244,228 L 196,370 C 192,382 184,390 172,390 L 98,448 C 86,456 72,448 72,434 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="72"
                    android:startY="75"
                    android:endX="220"
                    android:endY="440"
                    android:type="linear">
                    <item android:color="#FFFF5E3A" android:offset="0.0" />
                    <item android:color="#FFFF3B30" android:offset="0.3" />
                    <item android:color="#FFFF2D92" android:offset="0.75" />
                    <item android:color="#FFA855F7" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left Inner Glass Glow Edge -->
        <path
            android:pathData="M 78,135 C 78,102 105,82 138,98 C 168,112 194,152 225,224"
            android:strokeWidth="6"
            android:strokeColor="#88FFFFFF"
            android:strokeLineCap="round" />

        <!-- Right Ribbon Leg (Blue -> Cyan) -->
        <path
            android:pathData="M 440,130 C 440,90 404,68 364,88 C 330,105 302,148 268,228 L 316,370 C 320,382 328,390 340,390 L 414,448 C 426,456 440,448 440,434 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="280"
                    android:startY="150"
                    android:endX="440"
                    android:endY="440"
                    android:type="linear">
                    <item android:color="#FFA855F7" android:offset="0.0" />
                    <item android:color="#FF007AFF" android:offset="0.45" />
                    <item android:color="#FF32D7FF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right Inner Glass Glow Edge -->
        <path
            android:pathData="M 434,135 C 434,102 407,82 374,98 C 344,112 318,152 287,224"
            android:strokeWidth="6"
            android:strokeColor="#8832D7FF"
            android:strokeLineCap="round" />
    </group>
</vector>
